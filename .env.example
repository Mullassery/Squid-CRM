# Copy to .env and change every secret before running anywhere but localhost.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/squid
APP_SECRET=replace-with-at-least-32-random-characters
BIND_ADDR=0.0.0.0:3000
FRONTEND_URL=http://localhost:3001
COOKIE_SECURE=false

# Token lifetimes (seconds)
LOGIN_TOKEN_TTL_SECS=300
ACCESS_TOKEN_TTL_SECS=3600
REFRESH_TOKEN_TTL_SECS=2592000

# Pagination guard
MAX_PAGE_SIZE=100

# Reserved for the job/worker phase (not used by the current slice)
REDIS_URL=redis://localhost:6379
